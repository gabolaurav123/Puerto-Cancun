DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_SSL=require
DATABASE_POOL_MAX=5
NODE_ENV=production
APP_VERSION=1.0.0
RELEASE_SHA=
PUBLIC_SITE_URL=https://www.puertocancun.center
# Dominio público opcional para enlaces cortos de fichas, por ejemplo https://fichas.tudominio.com.
# Si queda vacío se usa PUBLIC_SITE_URL o el dominio de la solicitud.
PUBLIC_SHARE_DOMAIN=
SESSION_SECRET=change-this-with-at-least-32-random-characters
WHATSAPP_AUTH_SECRET=change-this-independent-secret-with-32-random-characters
ADMIN_USER=adminprueba
ADMIN_PASSWORD=change-this-admin-password-with-12-characters
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_IMAGE_QUALITY=medium
AI_BROCHURE_IMPORT=true
AI_IMAGE_ANALYSIS=true
SAVED_SEARCH_ALERTS=true
RESEND_API_KEY=
MAIL_FROM=Puerto Cancun Center <contacto@tu-dominio.com>
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_OAUTH_URL=
INSTAGRAM_PROFILE_URL=https://www.instagram.com/
GOOGLE_CLIENT_ID=
GOOGLE_MAPS_API_KEY=
MARKETING_IMAGE_HOSTS=
INDEXNOW_KEY=
PORT=3000
